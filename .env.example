EMBEDDING_PROVIDER=jina
JINA_API_KEY=your_jina_key_here
VOYAGE_API_KEY=

LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_key_here

VECTORSTORE_PROVIDER=qdrant
QDRANT_URL=your_qdrant_url_here
QDRANT_API_KEY=your_qdrant_key_here

SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_publishable_key_here
# service_role key from Supabase project settings. Bypasses RLS -- keep
# this server-side only, never ship it to a frontend/browser bundle.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Teacher invite token now lives in the app_secrets table in the database
# (see db/schema.sql), not here. Set it via the Supabase SQL editor:
#   UPDATE app_secrets SET value = '<token>' WHERE key = 'teacher_invite_token';
USE_RERANKER=false
