EMBEDDING_PROVIDER=jina
JINA_API_KEY=your_jina_key_here
VOYAGE_API_KEY=

LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_key_here

VECTORSTORE_PROVIDER=qdrant
QDRANT_URL=your_qdrant_url_here
QDRANT_API_KEY=your_qdrant_key_here

SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_publishable_key_here
# service_role key from Supabase project settings. Bypasses RLS -- keep
# this server-side only, never ship it to a frontend/browser bundle.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# The admin invite token lives in the app_secrets table, not here. After
# running db/hardening_patch.sql it is stored as a SHA-256 *hash* under the
# key 'admin_invite_token_sha256' -- storing the raw token there will never
# match. Set it from the Supabase SQL editor:
#
#   UPDATE app_secrets
#      SET value = encode(digest('<your-token>', 'sha256'), 'hex')
#    WHERE key = 'admin_invite_token_sha256';
#
# (digest() comes from pgcrypto; if it isn't on the search_path use
#  extensions.digest(...). Verify with: SELECT value FROM app_secrets;)
USE_RERANKER=false
